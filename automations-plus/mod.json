{
  "manifest_version": 2,
  "mod": {
    "id": "automations-plus",
    "name": "Arranger: Automations+",
    "version": "1.0.0-dev.1",
    "author": "ark-ain (based on shaboogen's Add Automation Points)",
    "description": "Automations+: adds points over an automation time selection (dialog or direct), a Hold mode for new automation points, and Automation Tools after FL Studio's: Scale Levels, Normalize, Flip, Smooth, Decimate, with a live preview. Based on shaboogen's Add Automation Points."
  },
  "built_against": {
    "bitwig_version": "6.1.4",
    "platform": "linux",
    "architecture": "x64"
  },
  "helper": {
    "jar": "helper.jar",
    "class": "AutomationsPlus"
  },

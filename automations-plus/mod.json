      "id": "hold-mode-double-click-description",
      "target": "com.bitwig.flt.widget.core.timeline.XzI.MRY",
      "transform": "REPLACE_INVOKE",
      "match": {
        "opcode": "INVOKESTATIC",
        "target": "com.bitwig.flt.widget.core.timeline.XzI.UNj",
        "occurrence": 1

{
  "manifest_version": 2,
  "mod": {
    "id": "keyboard-plus",
    "name": "Interface: Keyboard+ (Linux)",
    "area": "Interface",
    "version": "0.3.0-dev.1",
    "author": "ark-ain",
    "description": "Linux only (X11 or Xwayland). Keys pressed while a plug-in window has the focus also go to Bitwig: play notes with the computer keyboard, Space for the transport, shortcuts. The plug-in still gets its keys. Toggle it with the 'Toggle Keyboard+' action.",
    "documentation": "readme",
    "tags": [
      "linux",
      "keyboard",
      "plug-in windows"
    ]
  },
  "built_against": {
    "bitwig_version": "6.1.4",
    "platform": "linux",
    "architecture": "x64"
  },
  "targets": {},
  "hooks": [],
  "requires": [
    {
      "id": "action-menu-composition-framework",
      "min_version": "0.8.0-dev.1"
    }
  ],
  "registrations": [
    {
      "id": "actions",
      "consumer": "action-menu-composition-framework",
      "descriptor": "actions.properties",
      "jar": "helper.jar"
    }
  ],
  "resources": {
    "readme": {
      "kind": "file",
      "path": "README.md",
      "media_type": "text/markdown"
    }
  }
}